    ''' <summary>按 Id 取服务商名称，找不到时返回 Id 本身。</summary>
    Public Function AiProviderName(Id As String) As String
        For Each Line As String In AiProviders
            Dim Parts As String() = Line.Split("|"c)
            If Parts.Length >= 2 AndAlso Parts(0) = Id Then Return Parts(1)
        Next
        Return Id
    End Function


